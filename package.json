{
  "name": "portal-stage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two rooms. One stage. Borrowed Weather, a live theater directed by your Twitch community.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests scripts docs *.json *.ts *.md",
    "format:check": "prettier --check src tests scripts docs *.json *.ts *.md",
    "setup": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.2.8",
    "@fontsource/inter": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.0",
    "@neondatabase/serverless": "1.2.0",
    "@types/three": "0.187.0",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
