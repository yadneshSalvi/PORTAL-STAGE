# npm run setup writes private random signing/encryption keys.
APP_BASE_URL=http://localhost:3200
SESSION_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes).
TOKEN_ENCRYPTION_KEY=
# Optional in development (atomic file store); REQUIRED in production.
DATABASE_URL=
# Invited host Twitch show. Bootstrap user tokens are not used.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3200/auth/twitch/callback
TWITCH_ALLOWED_HOSTS=
# Live camera media. Local camera rehearsal does not use these services.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Public authenticated solo reservations. Requires Postgres, LiveKit and a
# confirmed durable Workflow scheduling receipt before any media issuance.
PORTAL_PUBLIC_SOLO=1
PORTAL_SOLO_PER_ACCOUNT_DAILY=3
PORTAL_SOLO_GLOBAL_DAILY=30
PORTAL_SOLO_GLOBAL_CONCURRENT=5
# Immutable per reservation, valid range 60–1800; default 20 minutes.
PORTAL_SOLO_SESSION_SECONDS=1200
# Optional independent development cache for a second guest server.
# PORTAL_DIST_DIR=.next-guest
# Optimized local-only media QA; never enable on a cloud deployment.
# Both APP_BASE_URL and LIVEKIT_URL must be literal loopback addresses.
# PORTAL_LOCAL_MEDIA_TEST=1
# Optional sanitized query duration/loop lag; no values or identifiers.
# PORTAL_TIMING_LOG=1
